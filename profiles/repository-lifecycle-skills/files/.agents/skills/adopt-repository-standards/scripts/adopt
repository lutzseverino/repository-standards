#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path


STABLE_VERSION = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
SEMANTIC_VERSION = re.compile(
    r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"
    r"(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$"
)
SUPPORTED_STANDARDS_VERSION = 4


class AdoptionError(Exception):
    pass


def _git(repository: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repository), *arguments],
        check=False,
        capture_output=True,
        text=True,
    )


def _manifest(repository: Path) -> tuple[Path, dict[str, object]]:
    candidates = [
        repository / name
        for name in (
            ".repository-standards.json",
            ".repository-standards.yml",
            ".repository-standards.yaml",
        )
        if (repository / name).is_file()
    ]
    if not candidates:
        raise ValueError("no repository standards manifest found")
    if len(candidates) > 1:
        raise ValueError(
            "multiple repository standards manifests found: "
            + ", ".join(path.name for path in candidates)
        )
    path = candidates[0]
    if path.suffix != ".json":
        raise ValueError(
            "dependency-free adoption requires .repository-standards.json"
        )
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read repository standards manifest: {exc}") from exc
    if not isinstance(value, dict):
        raise ValueError("repository standards manifest must contain an object")
    return path, value


def _stable_version(value: object, *, requested: bool) -> tuple[int, int, int]:
    if not isinstance(value, str):
        raise ValueError("standards release must be a stable semantic version")
    match = STABLE_VERSION.fullmatch(value)
    if match:
        major, minor, patch = match.groups()
        return int(major), int(minor), int(patch)
    if SEMANTIC_VERSION.fullmatch(value) and "-" in value:
        subject = "prerelease standards version" if requested else "adopted prerelease"
        raise ValueError(f"{subject} is not adoptable: {value}")
    if SEMANTIC_VERSION.fullmatch(value) and "+" in value:
        raise ValueError(f"build metadata is not a stable release: {value}")
    subject = "malformed standards version" if requested else "malformed adopted release"
    raise ValueError(f"{subject}: {value}")


def _latest_release() -> str:
    overridden = os.environ.get("REPOSITORY_STANDARDS_LATEST_RELEASE")
    if overridden:
        return overridden
    request = urllib.request.Request(
        "https://github.com/lutzseverino/repository-standards/releases/latest",
        method="HEAD",
        headers={"User-Agent": "adopt-repository-standards"},
    )
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            final_url = response.geturl()
    except (OSError, urllib.error.URLError) as exc:
        raise ValueError(f"cannot resolve latest stable GitHub Release: {exc}") from exc
    match = re.search(r"/releases/tag/v([^/?#]+)$", final_url)
    if not match:
        raise ValueError(
            f"latest GitHub Release did not resolve to a stable tag: {final_url}"
        )
    return match.group(1)


def _checked_out_release(version: str, temporary_root: Path) -> Path:
    reusable = os.environ.get("REPOSITORY_STANDARDS_CHECKOUT")
    if reusable:
        checkout = Path(reusable).expanduser().resolve()
    else:
        source = os.environ.get(
            "REPOSITORY_STANDARDS_SOURCE",
            "https://github.com/lutzseverino/repository-standards.git",
        )
        tag = f"v{version}"
        exists = subprocess.run(
            ["git", "ls-remote", "--exit-code", "--tags", source, f"refs/tags/{tag}"],
            check=False,
            capture_output=True,
            text=True,
        )
        if exists.returncode == 2:
            raise AdoptionError(f"stable release tag {tag} was not found at {source}")
        if exists.returncode != 0:
            raise AdoptionError(
                f"cannot inspect standards source {source}: "
                f"{exists.stderr.strip() or exists.stdout.strip()}"
            )
        checkout = temporary_root / "standards"
        cloned = subprocess.run(
            [
                "git",
                "clone",
                "--quiet",
                "--depth",
                "1",
                "--single-branch",
                "--branch",
                tag,
                source,
                str(checkout),
            ],
            check=False,
            capture_output=True,
            text=True,
        )
        if cloned.returncode != 0:
            raise AdoptionError(
                f"cannot obtain isolated checkout for {tag}: "
                f"{cloned.stderr.strip() or cloned.stdout.strip()}"
            )
    exact_tag = _git(checkout, "describe", "--tags", "--exact-match", "HEAD")
    if exact_tag.returncode != 0 or exact_tag.stdout.strip() != f"v{version}":
        actual = exact_tag.stdout.strip() or "no exact tag"
        raise AdoptionError(
            f"standards checkout is not proven at exact tag v{version}: {actual}"
        )
    status = _git(checkout, "status", "--porcelain=v1", "--untracked-files=all")
    if status.returncode != 0:
        raise AdoptionError(
            "cannot inspect exact release checkout: "
            + (status.stderr.strip() or status.stdout.strip())
        )
    dirty = [line[3:] for line in status.stdout.splitlines() if line]
    if dirty:
        raise AdoptionError(
            "exact release checkout must be clean; dirty paths: " + ", ".join(dirty)
        )
    try:
        declared = (checkout / "VERSION").read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise AdoptionError(f"cannot read release VERSION: {exc}") from exc
    if declared != version:
        raise AdoptionError(
            f"release tag v{version} declares incompatible VERSION {declared!r}"
        )
    return checkout


def _update_release(repository: Path, version: str) -> None:
    path, manifest = _manifest(repository)
    current = manifest.get("standards-release")
    text = path.read_text(encoding="utf-8")
    pattern = re.compile(
        r'("standards-release"\s*:\s*")' + re.escape(str(current)) + r'(")'
    )
    updated, count = pattern.subn(rf"\g<1>{version}\g<2>", text, count=1)
    if count != 1:
        raise AdoptionError(
            f"cannot update standards-release in dependency-free manifest {path.name}"
        )
    path.write_text(updated, encoding="utf-8")


def _run_phase(
    label: str,
    command: list[str] | str,
    *,
    repository: Path,
    allowed: tuple[int, ...] = (0,),
    shell: bool = False,
) -> None:
    print(f"\n== {label} ==")
    result = subprocess.run(
        command,
        cwd=repository,
        shell=shell,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode not in allowed:
        raise AdoptionError(f"{label} failed with exit code {result.returncode}")


def _release_tool(checkout: Path, name: str) -> str:
    tool = checkout / "scripts" / name
    if not tool.is_file():
        version = checkout.joinpath("VERSION").read_text(encoding="utf-8").strip()
        raise AdoptionError(f"release v{version} is missing scripts/{name}")
    return str(tool)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Adopt an exact or latest stable repository standards release"
    )
    parser.add_argument("version", nargs="?", help="exact stable version to adopt")
    parser.add_argument("--repository", default=".", help="target repository")
    parser.add_argument(
        "--validation-command",
        required=True,
        help="the target repository's canonical validation command",
    )
    args = parser.parse_args()
    requested_repository = Path(args.repository).expanduser().resolve()
    root_result = _git(requested_repository, "rev-parse", "--show-toplevel")
    if root_result.returncode != 0:
        print(
            f"error: target is not a Git repository: {requested_repository}",
            file=sys.stderr,
        )
        return 2
    repository = Path(root_result.stdout.strip()).resolve()
    status = _git(repository, "status", "--porcelain=v1", "--untracked-files=all")
    if status.returncode != 0:
        print(f"error: cannot inspect working tree: {status.stderr.strip()}", file=sys.stderr)
        return 2
    dirty = [line[3:] for line in status.stdout.splitlines() if line]
    if dirty:
        print("error: working tree must be clean before standards adoption", file=sys.stderr)
        print("Dirty paths:", file=sys.stderr)
        for path in dirty:
            print(f"- {path}", file=sys.stderr)
        return 2
    try:
        _, manifest = _manifest(repository)
        protocol = manifest.get("standards-version")
        if protocol != SUPPORTED_STANDARDS_VERSION:
            raise ValueError(
                f"incompatible standards-version {protocol!r}; adoption runner "
                f"requires {SUPPORTED_STANDARDS_VERSION}"
            )
        current_value = manifest.get("standards-release")
        current = _stable_version(current_value, requested=False)
        selected_version = args.version or _latest_release()
        requested = _stable_version(selected_version, requested=True)
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    if requested < current:
        print(
            f"error: standards downgrade rejected: {current_value} -> {selected_version}",
            file=sys.stderr,
        )
        return 2
    if requested == current:
        print(
            f"Repository already adopts standards release {selected_version}; no changes."
        )
        return 0
    if args.version is None:
        print(f"Resolved latest stable standards release: {selected_version}")
    try:
        with tempfile.TemporaryDirectory(prefix="repository-standards-adoption-") as directory:
            temporary_root = Path(directory)
            checkout = _checked_out_release(selected_version, temporary_root)
            preview = temporary_root / "preview"
            cloned = subprocess.run(
                ["git", "clone", "--quiet", "--no-hardlinks", str(repository), str(preview)],
                check=False,
                capture_output=True,
                text=True,
            )
            if cloned.returncode != 0:
                raise AdoptionError(
                    "cannot create isolated target preview: "
                    + (cloned.stderr.strip() or cloned.stdout.strip())
                )
            _update_release(preview, selected_version)

            _run_phase(
                "Offline preview",
                [_release_tool(checkout, "sync"), str(preview)],
                repository=preview,
                allowed=(0, 1),
            )
            _run_phase(
                "Live preview",
                [_release_tool(checkout, "sync-live"), str(preview)],
                repository=preview,
                allowed=(0, 1),
            )

            _update_release(repository, selected_version)
            _run_phase(
                "Offline write",
                [_release_tool(checkout, "sync"), "--write", str(repository)],
                repository=repository,
            )
            _run_phase(
                "Live write",
                [_release_tool(checkout, "sync-live"), "--write", str(repository)],
                repository=repository,
            )
            _run_phase(
                "Canonical validation",
                args.validation_command,
                repository=repository,
                shell=True,
            )
            _run_phase(
                "Offline standards audit",
                [_release_tool(checkout, "audit"), str(repository)],
                repository=repository,
            )
            _run_phase(
                "Live standards audit",
                [_release_tool(checkout, "audit-live"), str(repository)],
                repository=repository,
            )
    except (AdoptionError, ValueError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    print(
        f"\nPrepared standards adoption {current_value} -> {selected_version}; "
        "changes remain uncommitted."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
