#!/usr/bin/env python3

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from pathlib import Path


STABLE_VERSION = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
SEMANTIC_VERSION = re.compile(
    r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"
    r"(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$"
)
SUPPORTED_STANDARDS_VERSION = 5


class AdoptionError(Exception):
    pass


def _git(repository: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repository), *arguments],
        check=False,
        capture_output=True,
        text=True,
    )


def _manifest(repository: Path) -> tuple[Path, dict[str, object]]:
    candidates = _manifest_candidates(repository)
    if not candidates:
        raise ValueError("no repository standards manifest found")
    if len(candidates) > 1:
        raise ValueError(
            "multiple repository standards manifests found: "
            + ", ".join(path.name for path in candidates)
        )
    path = candidates[0]
    if path.suffix != ".json":
        raise ValueError(
            "dependency-free adoption requires .repository-standards.json"
        )
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ValueError(f"cannot read repository standards manifest: {exc}") from exc
    if not isinstance(value, dict):
        raise ValueError("repository standards manifest must contain an object")
    return path, value


def _manifest_candidates(repository: Path) -> list[Path]:
    return [
        repository / name
        for name in (
            ".repository-standards.json",
            ".repository-standards.yml",
            ".repository-standards.yaml",
        )
        if (repository / name).is_file()
    ]


def _stable_version(value: object, *, requested: bool) -> tuple[int, int, int]:
    if not isinstance(value, str):
        raise ValueError("standards release must be a stable semantic version")
    match = STABLE_VERSION.fullmatch(value)
    if match:
        major, minor, patch = match.groups()
        return int(major), int(minor), int(patch)
    if SEMANTIC_VERSION.fullmatch(value) and "-" in value:
        subject = "prerelease standards version" if requested else "adopted prerelease"
        raise ValueError(f"{subject} is not adoptable: {value}")
    if SEMANTIC_VERSION.fullmatch(value) and "+" in value:
        raise ValueError(f"build metadata is not a stable release: {value}")
    subject = "malformed standards version" if requested else "malformed adopted release"
    raise ValueError(f"{subject}: {value}")


def _latest_release() -> str:
    overridden = os.environ.get("REPOSITORY_STANDARDS_LATEST_RELEASE")
    if overridden:
        return overridden
    request = urllib.request.Request(
        "https://github.com/lutzseverino/repository-standards/releases/latest",
        method="HEAD",
        headers={"User-Agent": "adopt-standards"},
    )
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            final_url = response.geturl()
    except (OSError, urllib.error.URLError) as exc:
        raise ValueError(f"cannot resolve latest stable GitHub Release: {exc}") from exc
    match = re.search(r"/releases/tag/v([^/?#]+)$", final_url)
    if not match:
        raise ValueError(
            f"latest GitHub Release did not resolve to a stable tag: {final_url}"
        )
    return match.group(1)


def _checked_out_release(version: str, temporary_root: Path) -> Path:
    reusable = os.environ.get("REPOSITORY_STANDARDS_CHECKOUT")
    if reusable:
        checkout = Path(reusable).expanduser().resolve()
    else:
        source = os.environ.get(
            "REPOSITORY_STANDARDS_SOURCE",
            "https://github.com/lutzseverino/repository-standards.git",
        )
        tag = f"v{version}"
        exists = subprocess.run(
            ["git", "ls-remote", "--exit-code", "--tags", source, f"refs/tags/{tag}"],
            check=False,
            capture_output=True,
            text=True,
        )
        if exists.returncode == 2:
            raise AdoptionError(f"stable release tag {tag} was not found at {source}")
        if exists.returncode != 0:
            raise AdoptionError(
                f"cannot inspect standards source {source}: "
                f"{exists.stderr.strip() or exists.stdout.strip()}"
            )
        checkout = temporary_root / "standards"
        cloned = subprocess.run(
            [
                "git",
                "clone",
                "--quiet",
                "--depth",
                "1",
                "--single-branch",
                "--branch",
                tag,
                source,
                str(checkout),
            ],
            check=False,
            capture_output=True,
            text=True,
        )
        if cloned.returncode != 0:
            raise AdoptionError(
                f"cannot obtain isolated checkout for {tag}: "
                f"{cloned.stderr.strip() or cloned.stdout.strip()}"
            )
    exact_tag = _git(checkout, "describe", "--tags", "--exact-match", "HEAD")
    if exact_tag.returncode != 0 or exact_tag.stdout.strip() != f"v{version}":
        actual = exact_tag.stdout.strip() or "no exact tag"
        raise AdoptionError(
            f"standards checkout is not proven at exact tag v{version}: {actual}"
        )
    status = _git(checkout, "status", "--porcelain=v1", "--untracked-files=all")
    if status.returncode != 0:
        raise AdoptionError(
            "cannot inspect exact release checkout: "
            + (status.stderr.strip() or status.stdout.strip())
        )
    dirty = [line[3:] for line in status.stdout.splitlines() if line]
    if dirty:
        raise AdoptionError(
            "exact release checkout must be clean; dirty paths: " + ", ".join(dirty)
        )
    try:
        declared = (checkout / "VERSION").read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise AdoptionError(f"cannot read release VERSION: {exc}") from exc
    if declared != version:
        raise AdoptionError(
            f"release tag v{version} declares incompatible VERSION {declared!r}"
        )
    return checkout


def _update_release(repository: Path, version: str) -> None:
    path, manifest = _manifest(repository)
    current = manifest.get("standards-release")
    text = path.read_text(encoding="utf-8")
    pattern = re.compile(
        r'("standards-release"\s*:\s*")' + re.escape(str(current)) + r'(")'
    )
    updated, count = pattern.subn(rf"\g<1>{version}\g<2>", text, count=1)
    if count != 1:
        raise AdoptionError(
            f"cannot update standards-release in dependency-free manifest {path.name}"
        )
    path.write_text(updated, encoding="utf-8")


def _write_validation_declaration(
    repository: Path, declaration: dict[str, object]
) -> None:
    path, manifest = _manifest(repository)
    manifest["canonical-validation"] = declaration
    path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def _write_initial_manifest(repository: Path, manifest: dict[str, object]) -> None:
    path = repository / ".repository-standards.json"
    if path.exists() or path.is_symlink():
        raise AdoptionError(
            "initial adoption cannot replace an existing repository standards manifest"
        )
    path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def _build_initial_contract(
    checkout: Path, input_path: Path
) -> tuple[dict[str, object], list[dict[str, str]]]:
    result = subprocess.run(
        [
            _release_tool(checkout, "standards"),
            "create",
            "--contract-input",
            str(input_path),
            "--retain-content-blockers",
        ],
        check=False,
        capture_output=True,
        text=True,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
    )
    if result.returncode != 0:
        raise AdoptionError(
            "cannot build initial repository contract: "
            + (result.stderr.strip() or result.stdout.strip())
        )
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise AdoptionError(
            f"selected release returned an invalid initial contract: {exc}"
        ) from exc
    try:
        contract = value["contract"]
        conflicts = value["conflicts"]
    except (KeyError, TypeError) as exc:
        raise AdoptionError(
            "selected release returned an incomplete initial contract preview"
        ) from exc
    if not isinstance(contract, dict) or not isinstance(conflicts, list) or not all(
        isinstance(item, dict)
        and isinstance(item.get("target"), str)
        and isinstance(item.get("message"), str)
        for item in conflicts
    ):
        raise AdoptionError(
            "selected release returned an invalid initial contract preview"
        )
    return contract, conflicts


def _github_repository(repository: Path, supplied: str | None) -> str:
    if supplied:
        candidate = supplied
    else:
        origin = _git(repository, "remote", "get-url", "origin")
        if origin.returncode != 0:
            raise ValueError(
                "initial adoption cannot infer the GitHub repository; "
                "supply --github-repository owner/name"
            )
        url = origin.stdout.strip()
        patterns = (
            r"^https://github\.com/([^/\s]+/[^/\s]+?)(?:\.git)?/?$",
            r"^git@github\.com:([^/\s]+/[^/\s]+?)(?:\.git)?/?$",
            r"^ssh://git@github\.com/([^/\s]+/[^/\s]+?)(?:\.git)?/?$",
        )
        match = next(
            (match for pattern in patterns if (match := re.fullmatch(pattern, url))),
            None,
        )
        if match is None:
            raise ValueError(
                "initial adoption cannot infer a GitHub owner/name from origin; "
                "supply --github-repository owner/name"
            )
        candidate = match.group(1)
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", candidate):
        raise ValueError("GitHub repository must be an explicit owner/name")
    return candidate


def _facts(declarations: list[str]) -> dict[str, str | list[str]]:
    collected: dict[str, list[str]] = {}
    for declaration in declarations:
        if "=" not in declaration:
            raise ValueError(f"fact must use NAME=VALUE: {declaration!r}")
        name, value = declaration.split("=", 1)
        values = collected.setdefault(name, [])
        if not name or not value or value in values:
            raise ValueError(
                f"fact values must be unique and non-empty: {declaration!r}"
            )
        values.append(value)
    return {
        name: values[0] if len(values) == 1 else values
        for name, values in collected.items()
    }


def _initial_assessment(checkout: Path, preview: Path) -> dict[str, object]:
    result = subprocess.run(
        [
            _release_tool(checkout, "standards"),
            "check",
            "--json",
            str(preview),
        ],
        cwd=preview,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode not in (0, 1, 2):
        raise AdoptionError(
            "cannot assess the initial adoption proposal: "
            + (result.stderr.strip() or result.stdout.strip())
        )
    try:
        value = json.loads(result.stdout)
    except json.JSONDecodeError as exc:
        raise AdoptionError(
            "selected release returned an invalid initial adoption assessment"
        ) from exc
    required = {
        "differences",
        "evidence-gaps",
        "automatic-corrections",
        "required-maintainer-work",
    }
    if not isinstance(value, dict) or not required.issubset(value):
        raise AdoptionError(
            "selected release returned an incomplete initial adoption assessment"
        )
    return value


def _proposal_id(payload: dict[str, object]) -> str:
    encoded = json.dumps(
        payload, sort_keys=True, separators=(",", ":"), ensure_ascii=True
    ).encode("utf-8")
    return hashlib.sha256(encoded).hexdigest()[:16]


def _render_items(title: str, values: object) -> None:
    print(f"{title}:")
    if not isinstance(values, list) or not values:
        print("- none")
        return
    for value in values:
        if isinstance(value, dict):
            description = value.get("description") or value.get("action")
            subject = value.get("subject")
            if description:
                prefix = f"[{subject}] " if subject else ""
                print(f"- {prefix}{description}")
                continue
        print(f"- {json.dumps(value, sort_keys=True)}")


def _render_initial_proposal(
    *,
    proposal_id: str,
    release: str,
    repository: Path,
    contract: dict[str, object],
    contract_conflicts: list[dict[str, str]],
    assessment: dict[str, object],
    confirmation: str,
) -> None:
    print(f"Initial standards adoption proposal {proposal_id}")
    print(f"Selected exact release: {release}")
    print(f"Target repository: {repository}")
    print("Complete repository contract:")
    print(json.dumps(contract, indent=2, sort_keys=True))
    print("Managed environment and declared GitHub assessment:")
    print(json.dumps(assessment, indent=2, sort_keys=True))
    _render_items(
        "Conflicts and differences",
        [*contract_conflicts, *assessment["differences"]],
    )
    _render_items("Evidence gaps", assessment["evidence-gaps"])
    _render_items("Automatic corrections", assessment["automatic-corrections"])
    _render_items("Required maintainer work", assessment["required-maintainer-work"])
    print(f"Exact confirmation required: {confirmation}")
    print("No repository or GitHub mutation was performed.")


def _run_phase(
    label: str,
    command: list[str] | str,
    *,
    repository: Path,
    allowed: tuple[int, ...] = (0,),
    shell: bool = False,
) -> None:
    print(f"\n== {label} ==")
    result = subprocess.run(
        command,
        cwd=repository,
        shell=shell,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode not in allowed:
        raise AdoptionError(f"{label} failed with exit code {result.returncode}")


def _release_tool(checkout: Path, name: str) -> str:
    tool = checkout / "scripts" / name
    if not tool.is_file():
        version = checkout.joinpath("VERSION").read_text(encoding="utf-8").strip()
        raise AdoptionError(f"release v{version} is missing scripts/{name}")
    return str(tool)


def _managed_absences(checkout: Path, preview: Path) -> list[str]:
    result = subprocess.run(
        [
            _release_tool(checkout, "standards"),
            "check",
            "--scope",
            "content",
            "--json",
            str(preview),
        ],
        cwd=preview,
        check=False,
        capture_output=True,
        text=True,
    )
    print("\n== Standards adoption assessment ==")
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode not in (0, 1, 2):
        raise AdoptionError(
            "cannot assess the adoption preview: "
            + (result.stderr.strip() or result.stdout.strip())
        )
    try:
        report = json.loads(result.stdout)
        corrections = report["automatic-corrections"]
        return sorted(
            item["target"]
            for item in corrections
            if isinstance(item, dict)
            and item.get("kind") == "delete"
            and isinstance(item.get("target"), str)
            and item["target"]
        )
    except (json.JSONDecodeError, KeyError, TypeError) as exc:
        raise AdoptionError(
            "release standards check returned an invalid assessment"
        ) from exc


def _ignored_present_targets(repository: Path, targets: list[str]) -> list[str]:
    ignored: list[str] = []
    for target in targets:
        path = repository / target
        if not path.exists() and not path.is_symlink():
            continue
        check = _git(repository, "check-ignore", "--quiet", "--", target)
        if check.returncode == 0:
            ignored.append(target)
        elif check.returncode not in (1,):
            raise AdoptionError(
                f"cannot inspect ignore status for managed absence {target!r}: "
                f"{check.stderr.strip() or check.stdout.strip()}"
            )
    return ignored


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Adopt an exact or latest stable repository standards release"
    )
    parser.add_argument("version", nargs="?", help="exact stable version to adopt")
    parser.add_argument("--repository", default=".", help="target repository")
    parser.add_argument("--validation-executable")
    parser.add_argument("--validation-argument", action="append", default=[])
    parser.add_argument("--validation-working-directory", default=".")
    parser.add_argument("--github-repository")
    parser.add_argument("--title")
    parser.add_argument("--fact", action="append", default=[])
    parser.add_argument("--profile", action="append", default=[])
    parser.add_argument("--repository-owned", action="append", default=[])
    parser.add_argument("--no-ruleset", action="store_true")
    parser.add_argument("--confirm")
    parser.add_argument("--release-root", help=argparse.SUPPRESS)
    args = parser.parse_args()
    requested_repository = Path(args.repository).expanduser().resolve()
    root_result = _git(requested_repository, "rev-parse", "--show-toplevel")
    if root_result.returncode != 0:
        print(
            f"error: target is not a Git repository: {requested_repository}",
            file=sys.stderr,
        )
        return 2
    repository = Path(root_result.stdout.strip()).resolve()
    status = _git(repository, "status", "--porcelain=v1", "--untracked-files=all")
    if status.returncode != 0:
        print(f"error: cannot inspect working tree: {status.stderr.strip()}", file=sys.stderr)
        return 2
    dirty = [line[3:] for line in status.stdout.splitlines() if line]
    if dirty:
        print("error: working tree must be clean before standards adoption", file=sys.stderr)
        print("Dirty paths:", file=sys.stderr)
        for path in dirty:
            print(f"- {path}", file=sys.stderr)
        return 2
    try:
        candidates = _manifest_candidates(repository)
        if len(candidates) > 1:
            raise ValueError(
                "multiple repository standards manifests found: "
                + ", ".join(path.name for path in candidates)
            )
        initial_adoption = not candidates
        current_value: object | None = None
        current: tuple[int, int, int] | None = None
        validation_migration: dict[str, object] | None = None
        initial_contract_input: dict[str, object] | None = None
        if initial_adoption:
            head = _git(repository, "rev-parse", "--verify", "HEAD")
            if head.returncode != 0:
                raise ValueError(
                    "initial adoption requires an existing committed repository"
                )
            if not args.validation_executable:
                raise ValueError(
                    "initial adoption requires --validation-executable"
                )
            if len(args.profile) != len(set(args.profile)):
                raise ValueError("explicit profiles must not contain duplicates")
            github_repository = _github_repository(repository, args.github_repository)
            initial_contract_input = {
                "repository": github_repository,
                "title": args.title or repository.name,
                "facts": _facts(args.fact),
                "canonical-validation": {
                    "executable": args.validation_executable,
                    "arguments": args.validation_argument,
                    "working-directory": args.validation_working_directory,
                },
            }
            if args.profile:
                initial_contract_input["profiles"] = args.profile
            if args.repository_owned:
                if len(args.repository_owned) != len(set(args.repository_owned)):
                    raise ValueError(
                        "repository-owned declarations must not contain duplicates"
                    )
                initial_contract_input["repository-owned"] = args.repository_owned
            if args.no_ruleset:
                initial_contract_input["github"] = {"ruleset": None}
        else:
            initial_only = bool(
                args.github_repository
                or args.title
                or args.fact
                or args.profile
                or args.repository_owned
                or args.no_ruleset
                or args.confirm
            )
            if initial_only:
                raise ValueError(
                    "initial-adoption facts and confirmation cannot override an "
                    "existing repository contract"
                )
            _, manifest = _manifest(repository)
            protocol = manifest.get("standards-version")
            if protocol != SUPPORTED_STANDARDS_VERSION:
                raise ValueError(
                    f"incompatible standards-version {protocol!r}; adoption runner "
                    f"requires {SUPPORTED_STANDARDS_VERSION}"
                )
            current_value = manifest.get("standards-release")
            current = _stable_version(current_value, requested=False)
            supplied_validation = bool(
                args.validation_executable
                or args.validation_argument
                or args.validation_working_directory != "."
            )
            if "canonical-validation" in manifest:
                if supplied_validation:
                    raise ValueError(
                        "canonical validation is already declared and cannot be overridden"
                    )
            else:
                if not args.validation_executable:
                    raise ValueError(
                        "repository has no canonical-validation declaration; "
                        "migration requires --validation-executable"
                    )
                validation_migration = {
                    "executable": args.validation_executable,
                    "arguments": args.validation_argument,
                    "working-directory": args.validation_working_directory,
                }
        selected_version = args.version or _latest_release()
        requested = _stable_version(selected_version, requested=True)
        if initial_contract_input is not None:
            initial_contract_input["standards-release"] = selected_version
    except ValueError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2
    if current is not None and requested < current:
        print(
            f"error: standards downgrade rejected: {current_value} -> {selected_version}",
            file=sys.stderr,
        )
        return 2
    if args.version is None:
        print(f"Resolved latest stable standards release: {selected_version}")
    mutated = False
    try:
        with tempfile.TemporaryDirectory(prefix="repository-standards-adoption-") as directory:
            temporary_root = Path(directory)
            if args.release_root:
                checkout = Path(args.release_root).expanduser().resolve()
                declared = (checkout / "VERSION").read_text(encoding="utf-8").strip()
                if declared != selected_version:
                    raise AdoptionError(
                        f"active release declares {declared!r}, not {selected_version!r}"
                    )
            else:
                checkout = _checked_out_release(selected_version, temporary_root)
            preview = temporary_root / "preview"
            shutil.copytree(
                repository,
                preview,
                ignore=shutil.ignore_patterns(".git"),
            )
            initial_contract: dict[str, object] | None = None
            if initial_adoption:
                assert initial_contract_input is not None
                initialization_path = temporary_root / "initial-adoption.json"
                initialization_path.write_text(
                    json.dumps(initial_contract_input, indent=2) + "\n",
                    encoding="utf-8",
                )
                initial_contract, contract_conflicts = _build_initial_contract(
                    checkout, initialization_path
                )
                _write_initial_manifest(preview, initial_contract)
                assessment = _initial_assessment(checkout, preview)
                head_oid = _git(repository, "rev-parse", "HEAD").stdout.strip()
                proposal_payload: dict[str, object] = {
                    "repository": str(repository),
                    "head": head_oid,
                    "release": selected_version,
                    "contract": initial_contract,
                    "contract-conflicts": contract_conflicts,
                    "assessment": assessment,
                }
                proposal_id = _proposal_id(proposal_payload)
                confirmation = f"Adopt initial standards proposal {proposal_id}"
                if args.confirm is None:
                    _render_initial_proposal(
                        proposal_id=proposal_id,
                        release=selected_version,
                        repository=repository,
                        contract=initial_contract,
                        contract_conflicts=contract_conflicts,
                        assessment=assessment,
                        confirmation=confirmation,
                    )
                    return 0
                if args.confirm != confirmation:
                    raise AdoptionError(
                        "initial adoption proposal is stale or was not confirmed "
                        "exactly; review the current complete proposal before mutation"
                    )
                if (
                    contract_conflicts
                    or assessment["evidence-gaps"]
                    or assessment["required-maintainer-work"]
                ):
                    raise AdoptionError(
                        "the confirmed initial adoption proposal still has conflicts, "
                        "evidence gaps, or required maintainer work; resolve them and "
                        "review a fresh proposal before mutation"
                    )
                delete_targets = sorted(
                    item["target"]
                    for item in assessment["automatic-corrections"]
                    if isinstance(item, dict)
                    and item.get("kind") == "delete"
                    and isinstance(item.get("target"), str)
                    and item["target"]
                )
                ignored_absences = _ignored_present_targets(
                    repository, delete_targets
                )
                if ignored_absences:
                    raise AdoptionError(
                        "ignored managed absences cannot be previewed from the "
                        "isolated checkout; remove or unignore these paths before "
                        "adoption: "
                        + ", ".join(ignored_absences)
                    )
                print(
                    f"Confirmed current initial adoption proposal {proposal_id}; "
                    f"selected exact release: {selected_version}."
                )
                _write_initial_manifest(repository, initial_contract)
                mutated = True
            else:
                _update_release(preview, selected_version)
                if validation_migration is not None:
                    _write_validation_declaration(preview, validation_migration)

                ignored_absences = _ignored_present_targets(
                    repository, _managed_absences(checkout, preview)
                )
                if ignored_absences:
                    raise AdoptionError(
                        "ignored managed absences cannot be previewed from the isolated "
                        "checkout; remove or unignore these paths before adoption: "
                        + ", ".join(ignored_absences)
                    )

                _update_release(repository, selected_version)
                mutated = True
                if validation_migration is not None:
                    _write_validation_declaration(repository, validation_migration)
            _run_phase(
                "Standards repair",
                [_release_tool(checkout, "standards"), "repair", str(repository)],
                repository=repository,
            )
            _run_phase(
                "Canonical validation",
                [
                    sys.executable,
                    str(checkout / "scripts/lib/canonical_validation.py"),
                    "--standards-root",
                    str(checkout),
                    str(repository),
                ],
                repository=repository,
            )
            _run_phase(
                "Final standards check",
                [_release_tool(checkout, "standards"), "check", str(repository)],
                repository=repository,
            )
            staged = _git(repository, "add", "--all")
            if staged.returncode != 0:
                raise AdoptionError(
                    "cannot stage the validated adoption: "
                    + (staged.stderr.strip() or staged.stdout.strip())
                )
            committed = _git(
                repository,
                "commit",
                "--allow-empty",
                "--message",
                f"chore(standards): adopt repository standards {selected_version}",
            )
            if committed.returncode != 0:
                raise AdoptionError(
                    "cannot create the validated adoption commit: "
                    + (committed.stderr.strip() or committed.stdout.strip())
                )
            commit_oid = _git(repository, "rev-parse", "HEAD").stdout.strip()
    except (AdoptionError, ValueError, OSError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        if mutated:
            head_oid = _git(repository, "rev-parse", "HEAD").stdout.strip()
            retained = _git(
                repository, "status", "--porcelain=v1", "--untracked-files=all"
            ).stdout
            transition = "Initial adoption" if initial_adoption else "Standards adoption"
            print(f"{transition} retained state:", file=sys.stderr)
            print(f"- current commit: {head_oid}", file=sys.stderr)
            print(
                "- partial repository changes: "
                + ("retained and uncommitted" if retained else "none observed"),
                file=sys.stderr,
            )
            print(
                "- recovery inspection: review git status and git diff; successful "
                "GitHub corrections remain applied and are safe to reconcile again",
                file=sys.stderr,
            )
            print(
                "- recovery boundary: adopt-standards requires a clean working tree "
                "and cannot be rerun while these local changes remain uncommitted",
                file=sys.stderr,
            )
            print(
                "- recovery options: after resolving the reported failure, either "
                "create an explicitly non-readiness checkpoint commit to retain the "
                "partial work, or restore the local changes to the current commit; "
                "then rerun adopt-standards and review its fresh proposal or repair",
                file=sys.stderr,
            )
            print("- GitHub delivery was not performed", file=sys.stderr)
        return 2
    if initial_adoption:
        print(
            f"\nPrepared initial standards adoption for {selected_version}; "
            f"validated adoption commit: {commit_oid}."
        )
        print("GitHub delivery remains a separate lifecycle transition.")
    elif requested == current:
        print(
            f"\nReconciled standards release {selected_version}; "
            f"validated adoption commit: {commit_oid}."
        )
    else:
        print(
            f"\nPrepared standards adoption {current_value} -> {selected_version}; "
            f"validated adoption commit: {commit_oid}."
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
