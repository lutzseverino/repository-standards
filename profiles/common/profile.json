{
  "name": "common",
  "description": "Exact repository-wide community and editor conventions",
  "extends": ["agent-skills"],
  "github": {
    "required-labels": [
      "bug",
      "enhancement",
      "needs-triage",
      "needs-info",
      "ready-for-agent",
      "ready-for-human",
      "wontfix"
    ]
  },
  "files": [
    {"mode": "exact", "source": "files/.editorconfig", "target": ".editorconfig"},
    {"mode": "exact", "source": "files/.gitattributes", "target": ".gitattributes"},
    {"mode": "exact", "source": "files/AGENTS.md", "target": "AGENTS.md"},
    {"mode": "exact", "source": "files/CONTRIBUTING.md", "target": "CONTRIBUTING.md"},
    {"mode": "exact", "source": "files/docs/agents/issue-tracker.md", "target": "docs/agents/issue-tracker.md"},
    {"mode": "exact", "source": "files/docs/agents/triage-labels.md", "target": "docs/agents/triage-labels.md"},
    {"mode": "exact", "source": "files/.github/ISSUE_TEMPLATE/config.yml", "target": ".github/ISSUE_TEMPLATE/config.yml"},
    {"mode": "absent", "target": ".github/ISSUE_TEMPLATE/project-task.yml"},
    {"mode": "absent", "target": ".github/ISSUE_TEMPLATE/bug-report.yml"},
    {"mode": "absent", "target": ".github/pull_request_template.md"},
    {"mode": "absent", "target": ".github/scripts/check-pr-policy.py"},
    {"mode": "exact", "source": "files/.github/scripts/check-workflows.py", "target": ".github/scripts/check-workflows.py"},
    {"mode": "absent", "target": ".github/workflows/pr-policy.yml"},
    {"mode": "compose", "source": "fragments/gitignore", "target": ".gitignore", "order": 0}
  ]
}
