{
  "standards-version": 5,
  "standards-release": "5.0.0",
  "profiles": [
    "common",
    "documentation",
    "pnpm-workspace",
    "vite-react",
    "spring-boot"
  ],
  "boundaries": [
    {
      "path": ".",
      "type": "repository",
      "title": "Example Repository"
    },
    {
      "path": "services/example",
      "type": "project",
      "title": "Example Service"
    }
  ],
  "dependency-updates": [
    {"ecosystem": "github-actions", "directory": "/", "schedule": "weekly"},
    {"ecosystem": "npm", "directory": "/", "schedule": "weekly"},
    {"ecosystem": "maven", "directory": "/services/example", "schedule": "weekly"}
  ],
  "github": {
    "repository": "example/repository",
    "default-branch": "main",
    "settings": {
      "delete-branch-on-merge": true,
      "allow-squash-merge": true,
      "allow-merge-commit": false,
      "allow-rebase-merge": false,
      "squash-merge-commit-title": "PR_TITLE",
      "squash-merge-commit-message": "PR_BODY"
    },
    "features": {
      "issues": true,
      "projects": false,
      "wiki": false
    },
    "ruleset": {
      "name": "Protect main",
      "required-status-checks": ["CI / Required"],
      "require-current-branch": true,
      "required-approvals": 0,
      "allowed-merge-methods": ["squash"],
      "prevent-deletion": true,
      "prevent-force-push": true,
      "allow-bypass-actors": false
    }
  },
  "variables": {},
  "local-fragments": {
    ".gitignore": [
      ".repository-standards/gitignore.local"
    ]
  },
  "repository-owned": [
    "README.md",
    "LICENSE",
    "CONTEXT.md",
    "docs/README.md",
    "docs/agents/domain.md",
    "docs/adr/**",
    "docs/explanation/**",
    "docs/how-to/**",
    "docs/reference/**",
    "docs/tutorials/**",
    "src/**",
    "apps/**",
    "services/**",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "pom.xml",
    ".github/workflows/ci.yml",
    ".github/workflows/release.yml"
  ]
}
