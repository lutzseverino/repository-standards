#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.error
import urllib.request
from enum import Enum
from pathlib import Path


STABLE_VERSION = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
IDENTITY = re.compile(r"^[A-Za-z0-9_.-]+$")
class CreationError(Exception):
    pass


class RemoteState(Enum):
    NOT_ATTEMPTED = "not-attempted"
    ABSENT = "absent"
    CREATED = "created"
    UNKNOWN = "unknown"


def _git(repository: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repository), *arguments],
        check=False,
        capture_output=True,
        text=True,
    )


def _latest_release() -> str:
    overridden = os.environ.get("REPOSITORY_STANDARDS_LATEST_RELEASE")
    if overridden:
        return overridden
    request = urllib.request.Request(
        "https://github.com/lutzseverino/repository-standards/releases/latest",
        method="HEAD",
        headers={"User-Agent": "create-repository"},
    )
    try:
        with urllib.request.urlopen(request, timeout=5) as response:
            final_url = response.geturl()
    except (OSError, urllib.error.URLError) as exc:
        raise CreationError(f"cannot resolve latest stable GitHub Release: {exc}") from exc
    match = re.search(r"/releases/tag/v([^/?#]+)$", final_url)
    if not match:
        raise CreationError(
            f"latest GitHub Release did not resolve to a stable tag: {final_url}"
        )
    return match.group(1)


def _stable_version(value: str) -> str:
    if not STABLE_VERSION.fullmatch(value):
        raise CreationError(
            f"standards release must be an exact stable semantic version: {value!r}"
        )
    return value


def _checked_out_release(version: str, temporary_root: Path) -> Path:
    reusable = os.environ.get("REPOSITORY_STANDARDS_CHECKOUT")
    if reusable:
        checkout = Path(reusable).expanduser().resolve()
    else:
        source = os.environ.get(
            "REPOSITORY_STANDARDS_SOURCE",
            "https://github.com/lutzseverino/repository-standards.git",
        )
        tag = f"v{version}"
        exists = subprocess.run(
            ["git", "ls-remote", "--exit-code", "--tags", source, f"refs/tags/{tag}"],
            check=False,
            capture_output=True,
            text=True,
        )
        if exists.returncode == 2:
            raise CreationError(f"stable release tag {tag} was not found at {source}")
        if exists.returncode != 0:
            raise CreationError(
                f"cannot inspect standards source {source}: "
                f"{exists.stderr.strip() or exists.stdout.strip()}"
            )
        checkout = temporary_root / "standards"
        cloned = subprocess.run(
            [
                "git",
                "clone",
                "--quiet",
                "--depth",
                "1",
                "--single-branch",
                "--branch",
                tag,
                source,
                str(checkout),
            ],
            check=False,
            capture_output=True,
            text=True,
        )
        if cloned.returncode != 0:
            raise CreationError(
                f"cannot obtain isolated checkout for {tag}: "
                f"{cloned.stderr.strip() or cloned.stdout.strip()}"
            )

    exact_tag = _git(checkout, "describe", "--tags", "--exact-match", "HEAD")
    if exact_tag.returncode != 0 or exact_tag.stdout.strip() != f"v{version}":
        actual = exact_tag.stdout.strip() or "no exact tag"
        raise CreationError(
            f"standards checkout is not proven at exact tag v{version}: {actual}"
        )
    status = _git(checkout, "status", "--porcelain=v1", "--untracked-files=all")
    if status.returncode != 0:
        raise CreationError(
            "cannot inspect exact release checkout: "
            + (status.stderr.strip() or status.stdout.strip())
        )
    if status.stdout.strip():
        raise CreationError(
            "exact release checkout must be clean; dirty paths: "
            + ", ".join(line[3:] for line in status.stdout.splitlines() if line)
        )
    try:
        declared = (checkout / "VERSION").read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise CreationError(f"cannot read release VERSION: {exc}") from exc
    if declared != version:
        raise CreationError(
            f"release tag v{version} declares incompatible VERSION {declared!r}"
        )
    for tool in ("init", "sync", "audit", "sync-live", "audit-live"):
        if not (checkout / "scripts" / tool).is_file():
            raise CreationError(f"release v{version} is missing scripts/{tool}")
    return checkout


def _destination(value: str) -> Path:
    requested = Path(value).expanduser()
    if not requested.is_absolute():
        raise CreationError("local destination must be an absolute path")
    if requested == Path(requested.anchor):
        raise CreationError("local destination must not be a filesystem root")
    for candidate in (requested, *requested.parents):
        if candidate == Path(candidate.anchor):
            break
        if candidate.is_symlink():
            raise CreationError(
                f"local destination traverses a symbolic link: {candidate}"
            )
    destination = requested.resolve(strict=False)
    if destination.exists():
        if not destination.is_dir() or next(destination.iterdir(), None) is not None:
            raise CreationError(
                f"local destination collision; expected an empty path: {destination}"
            )
    return destination


def _gh(*arguments: str) -> subprocess.CompletedProcess[str]:
    executable = os.environ.get("REPOSITORY_STANDARDS_GH", "gh")
    return subprocess.run(
        [executable, *arguments],
        check=False,
        capture_output=True,
        text=True,
    )


def _observe_github_repository(repository: str) -> RemoteState:
    observed = _gh("api", f"repos/{repository}")
    if observed.returncode == 0:
        return RemoteState.CREATED
    message = observed.stderr.strip() or observed.stdout.strip()
    if "404" in message or "not found" in message.lower():
        return RemoteState.ABSENT
    return RemoteState.UNKNOWN


def _preflight_github(repository: str) -> None:
    authenticated = _gh("auth", "status")
    if authenticated.returncode != 0:
        raise CreationError(
            "GitHub authentication failed: "
            + (authenticated.stderr.strip() or authenticated.stdout.strip())
        )
    observation = _observe_github_repository(repository)
    if observation is RemoteState.CREATED:
        raise CreationError(f"GitHub identity collision; repository exists: {repository}")
    if observation is RemoteState.UNKNOWN:
        raise CreationError(f"cannot verify GitHub identity {repository}")


def _run_phase(
    label: str,
    command: list[str],
    *,
    cwd: Path,
    allowed: tuple[int, ...] = (0,),
) -> None:
    print(f"\n== {label} ==")
    result = subprocess.run(
        command,
        cwd=cwd,
        check=False,
        capture_output=True,
        text=True,
    )
    if result.stdout:
        print(result.stdout, end="")
    if result.stderr:
        print(result.stderr, end="", file=sys.stderr)
    if result.returncode not in allowed:
        raise CreationError(f"{label} failed with exit code {result.returncode}")


def _tool(checkout: Path, name: str) -> str:
    return str(checkout / "scripts" / name)


def _mit_license(owner: str) -> str:
    return f"""MIT License

Copyright (c) {owner}

Permission is hereby granted, free of charge, to any person obtaining a copy
of this software and associated documentation files (the "Software"), to deal
in the Software without restriction, including without limitation the rights
to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
copies of the Software, and to permit persons to whom the Software is
furnished to do so, subject to the following conditions:

The above copyright notice and this permission notice shall be included in all
copies or substantial portions of the Software.

THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.
"""


def _write_repository_content(
    repository: Path, *, name: str, purpose: str, owner: str
) -> None:
    files = {
        "README.md": (
            f'<div align="center">\n  <h1>{name}</h1>\n'
            f"  <p>{purpose}</p>\n</div>\n\n"
            "See the [documentation](docs/README.md).\n"
        ),
        "LICENSE": _mit_license(owner),
        "CONTEXT.md": (
            f"# {name}\n\nCanonical language for {purpose.rstrip('.').lower()}.\n\n"
            "## Language\n\nAdd terms here when the repository resolves them.\n"
        ),
        "docs/README.md": (
            "# Documentation\n\nRepository documentation is organized by purpose.\n\n"
            "- `tutorials/` for learning-oriented lessons.\n"
            "- `how-to/` for task-oriented guides.\n"
            "- `reference/` for factual lookup.\n"
            "- `explanation/` for understanding and rationale.\n"
            "- `adr/` for architectural decisions.\n"
        ),
        "docs/agents/domain.md": (
            "# Domain docs\n\nThis repository uses a single domain context.\n\n"
            "Before exploring or naming domain concepts, read `CONTEXT.md` at the "
            "repository root and relevant records in `docs/adr/`.\n"
        ),
    }
    for relative, content in files.items():
        path = repository / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content, encoding="utf-8")


def _retained_state(
    destination: Path,
    *,
    local_state: str,
    repository_name: str | None,
    remote_state: RemoteState,
    origin_configured: bool,
    live_state: str,
) -> None:
    print("\nRetained state after failure:", file=sys.stderr)
    print(
        f"- local destination: {'present' if destination.exists() else 'not created'} "
        f"({destination}); phase: {local_state}",
        file=sys.stderr,
    )
    if remote_state is RemoteState.CREATED:
        remote_description = "created and retained"
    elif remote_state is RemoteState.ABSENT:
        remote_description = "confirmed absent"
    elif remote_state is RemoteState.UNKNOWN:
        remote_description = (
            "state unknown after attempted creation; inspect "
            f"{repository_name or 'the requested identity'} before retry"
        )
    else:
        remote_description = "not created by this operation; creation not attempted"
    print(f"- GitHub repository: {remote_description}", file=sys.stderr)
    print(
        f"- origin: {'configured' if origin_configured else 'not configured'}",
        file=sys.stderr,
    )
    print(f"- prepared live reconciliation: {live_state}", file=sys.stderr)
    print("- no automatic deletion or rollback was attempted", file=sys.stderr)


def main() -> int:
    parser = argparse.ArgumentParser(description="Create a prepared creation baseline")
    parser.add_argument("--name", required=True)
    parser.add_argument("--purpose", required=True)
    parser.add_argument(
        "--visibility", required=True, choices=("private", "public", "internal")
    )
    parser.add_argument("--license", required=True, choices=("MIT",))
    parser.add_argument("--owner", required=True)
    parser.add_argument("--destination", required=True)
    parser.add_argument("--version")
    parser.add_argument("--fact", action="append", default=[])
    parser.add_argument("--profile", action="append", default=[])
    args = parser.parse_args()

    remote_state = RemoteState.NOT_ATTEMPTED
    remote_creation_attempted = False
    origin_configured = False
    local_state = "not created"
    live_state = "not started"
    destination = Path(args.destination).expanduser()
    repository_name: str | None = None
    try:
        if not IDENTITY.fullmatch(args.name) or not IDENTITY.fullmatch(args.owner):
            raise CreationError("repository name and owner must be explicit GitHub identities")
        if not args.purpose.strip() or "\n" in args.purpose:
            raise CreationError("purpose must be one explicit non-empty line")
        destination = _destination(args.destination)
        facts: dict[str, str] = {}
        for declaration in args.fact:
            if "=" not in declaration:
                raise CreationError(f"fact must use NAME=VALUE: {declaration!r}")
            name, value = declaration.split("=", 1)
            if not name or not value or name in facts:
                raise CreationError(f"fact must be unique and non-empty: {declaration!r}")
            facts[name] = value
        if len(args.profile) != len(set(args.profile)):
            raise CreationError("explicit profiles must not contain duplicates")

        selected_version = _stable_version(args.version or _latest_release())
        repository_name = f"{args.owner}/{args.name}"
        _preflight_github(repository_name)
        remote_state = RemoteState.ABSENT

        with tempfile.TemporaryDirectory(prefix="repository-creation-") as directory:
            temporary_root = Path(directory)
            checkout = _checked_out_release(selected_version, temporary_root)
            initialization_path = temporary_root / "initialization.json"
            initialization: dict[str, object] = {
                "standards-release": selected_version,
                "repository": repository_name,
                "title": args.name,
                "facts": facts,
            }
            if args.profile:
                initialization["profiles"] = args.profile
            initialization_path.write_text(
                json.dumps(initialization, indent=2) + "\n", encoding="utf-8"
            )

            _run_phase(
                "Initial contract preview",
                [
                    _tool(checkout, "init"),
                    "--input",
                    str(initialization_path),
                    str(destination),
                ],
                cwd=temporary_root,
                allowed=(0, 1),
            )
            _run_phase(
                "Initial contract write",
                [
                    _tool(checkout, "init"),
                    "--input",
                    str(initialization_path),
                    "--write",
                    str(destination),
                ],
                cwd=temporary_root,
            )
            local_state = "validated initial contract written"
            initialized = _git(destination, "init", "--quiet", "--initial-branch=main")
            if initialized.returncode != 0:
                raise CreationError(
                    "cannot initialize local Git repository: "
                    + (initialized.stderr.strip() or initialized.stdout.strip())
                )
            _write_repository_content(
                destination,
                name=args.name,
                purpose=args.purpose,
                owner=args.owner,
            )
            local_state = "unborn main with repository-owned content"
            _run_phase(
                "Offline synchronization preview",
                [_tool(checkout, "sync"), str(destination)],
                cwd=destination,
                allowed=(0, 1),
            )
            _run_phase(
                "Offline synchronization write",
                [_tool(checkout, "sync"), "--write", str(destination)],
                cwd=destination,
            )
            _run_phase(
                "Offline standards audit",
                [_tool(checkout, "audit"), str(destination)],
                cwd=destination,
            )
            local_state = "offline baseline validated"

            remote_creation_attempted = True
            created = _gh(
                "repo",
                "create",
                repository_name,
                f"--{args.visibility}",
                "--description",
                args.purpose,
                "--disable-wiki",
            )
            if created.returncode != 0:
                raise CreationError(
                    "GitHub repository creation failed: "
                    + (created.stderr.strip() or created.stdout.strip())
                )
            remote_state = RemoteState.CREATED
            added = _git(
                destination,
                "remote",
                "add",
                "origin",
                f"https://github.com/{repository_name}.git",
            )
            if added.returncode != 0:
                raise CreationError(
                    "cannot configure origin: "
                    + (added.stderr.strip() or added.stdout.strip())
                )
            origin_configured = True

            _run_phase(
                "Prepared live synchronization preview",
                [
                    _tool(checkout, "sync-live"),
                    "--lifecycle",
                    "prepared",
                    str(destination),
                ],
                cwd=destination,
                allowed=(0, 1),
            )
            live_state = "preview completed"
            _run_phase(
                "Prepared live synchronization write",
                [
                    _tool(checkout, "sync-live"),
                    "--lifecycle",
                    "prepared",
                    "--write",
                    str(destination),
                ],
                cwd=destination,
            )
            live_state = "applicable changes applied"
            _run_phase(
                "Prepared live standards audit",
                [
                    _tool(checkout, "audit-live"),
                    "--lifecycle",
                    "prepared",
                    str(destination),
                ],
                cwd=destination,
            )
            live_state = "validated; publication requirements pending"

        head = _git(destination, "rev-parse", "--verify", "HEAD")
        if head.returncode == 0:
            raise CreationError("creation unexpectedly produced a local commit")
        branches = _gh("api", f"repos/{repository_name}/branches")
        if branches.returncode != 0:
            raise CreationError(
                "cannot verify empty GitHub repository: "
                + (branches.stderr.strip() or branches.stdout.strip())
            )
        try:
            observed_branches = json.loads(branches.stdout)
        except json.JSONDecodeError as exc:
            raise CreationError("GitHub branches response was not valid JSON") from exc
        if observed_branches:
            raise CreationError("creation unexpectedly published a GitHub branch")
    except (CreationError, OSError) as exc:
        if (
            repository_name
            and remote_creation_attempted
            and remote_state is not RemoteState.CREATED
        ):
            remote_state = _observe_github_repository(repository_name)
        if destination.is_dir():
            observed_origin = _git(destination, "remote", "get-url", "origin")
            origin_configured = observed_origin.returncode == 0
        print(f"error: {exc}", file=sys.stderr)
        _retained_state(
            destination,
            local_state=local_state,
            repository_name=repository_name,
            remote_state=remote_state,
            origin_configured=origin_configured,
            live_state=live_state,
        )
        return 2

    print(f"\nPrepared creation baseline: {args.owner}/{args.name}")
    print(f"- local baseline: {destination} (uncommitted on main)")
    print("- GitHub repository: empty; origin is configured")
    print("- required next lifecycle operation: first publication")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
