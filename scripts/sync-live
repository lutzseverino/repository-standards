#!/usr/bin/env python3

from __future__ import annotations

import argparse
import sys
from pathlib import Path

from lib.live_reconciliation import (
    GitHubCliAdapter,
    apply_live_delta,
    reconcile_live_github,
)
from lib.repository_contract import ContractError, resolve_repository_contract
from lib.standards import StandardsError, standards_root


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Preview or write the declared live GitHub contract"
    )
    parser.add_argument("repository", help="repository checkout to synchronize")
    parser.add_argument("--manifest", help="manifest path, relative to repository")
    parser.add_argument("--write", action="store_true", help="apply planned operations")
    args = parser.parse_args()
    repository = Path(args.repository).expanduser().resolve()
    try:
        repository_contract = resolve_repository_contract(
            repository,
            standards_root=standards_root(),
            manifest=args.manifest,
        )
        contract = repository_contract.github
        adapter = GitHubCliAdapter()
        snapshot = adapter.observe(repository_contract)
        delta = reconcile_live_github(repository_contract, snapshot)
        operations = delta.operations
    except (StandardsError, ContractError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if not operations:
        print(f"Live GitHub contract is current for {contract.repository}.")
        return 0
    for operation in operations:
        print(operation.description)
    if not args.write:
        print(
            f"\nPreview: {len(operations)} live operation(s) would be applied. "
            "Re-run with --write."
        )
        return 1
    report = apply_live_delta(delta, adapter)
    if not report.complete:
        print(f"error: {report.error}", file=sys.stderr)
        print("Completed operations:", file=sys.stderr)
        if report.completed:
            for completed in report.completed:
                print(f"- {completed.description}", file=sys.stderr)
        else:
            print("- none", file=sys.stderr)
        print("Failed operation:", file=sys.stderr)
        print(f"- {report.failed.description}", file=sys.stderr)
        print("Remaining operations:", file=sys.stderr)
        if report.remaining:
            for remaining in report.remaining:
                print(f"- {remaining.description}", file=sys.stderr)
        else:
            print("- none", file=sys.stderr)
        return 2
    print(f"\nApplied {len(operations)} live operation(s) to {contract.repository}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
