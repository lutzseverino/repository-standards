#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from lib.live_reconciliation import (
    GitHubCliAdapter,
    LiveLifecycle,
    reconcile_live_github,
    render_live_audit,
)
from lib.repository_contract import ContractError, resolve_repository_contract
from lib.standards import StandardsError, standards_root


def main() -> int:
    parser = argparse.ArgumentParser(description="Audit live GitHub repository settings")
    parser.add_argument("repository", help="repository checkout to audit")
    parser.add_argument("--manifest", help="manifest path, relative to repository")
    parser.add_argument(
        "--lifecycle",
        choices=("prepared", "published"),
        default="published",
        help="repository lifecycle state used to determine applicable requirements",
    )
    parser.add_argument("--json", action="store_true", dest="json_output")
    args = parser.parse_args()
    repository = Path(args.repository).expanduser().resolve()
    try:
        repository_contract = resolve_repository_contract(
            repository,
            standards_root=standards_root(),
            manifest=args.manifest,
        )
        contract = repository_contract.github
        adapter = GitHubCliAdapter()
        lifecycle = LiveLifecycle(args.lifecycle)
        snapshot = adapter.observe(repository_contract, lifecycle=lifecycle)
        delta = reconcile_live_github(repository_contract, snapshot)
        pending = set(delta.pending_findings)
        errors = [finding for finding in render_live_audit(delta) if finding not in pending]
    except (StandardsError, ContractError) as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if args.json_output:
        print(
            json.dumps(
                {
                    "repository": contract.repository,
                    "clean": delta.clean,
                    "applicable-clean": not errors,
                    "errors": errors,
                    "pending": list(delta.pending_findings),
                },
                indent=2,
            )
        )
    elif errors:
        print(f"Live GitHub settings drift for {contract.repository}:")
        for error in errors:
            print(f"- {error}")
        for finding in delta.pending_findings:
            print(f"- {finding}")
    elif delta.pending_findings:
        print(f"Prepared live GitHub contract for {contract.repository}:")
        for finding in delta.pending_findings:
            print(f"- {finding}")
        print("First publication is still required.")
    else:
        print(f"Live GitHub settings conform for {contract.repository}.")
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
