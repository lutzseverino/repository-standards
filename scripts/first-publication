#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import sys
from datetime import datetime, timezone
from pathlib import Path

from lib.first_publication import (
    PublicationError,
    PublicationPlan,
    load_publication_plan,
    plan_first_publication,
    publish_first_publication,
    write_publication_plan,
)
from lib.live_reconciliation import GitHubCliAdapter
from lib.standards import standards_root


def _render_plan(plan: PublicationPlan, path: Path) -> None:
    timestamp = datetime.fromtimestamp(
        plan.commit.timestamp, timezone.utc
    ).isoformat()
    print(f"First publication Plan {plan.plan_id}")
    print(f"- repository: {plan.repository_name} ({plan.repository})")
    print(
        f"- selected release: {plan.standards_release} "
        f"(protocol {plan.standards_protocol})"
    )
    print(f"- branch: {plan.branch}")
    print(f"- origin: {plan.remote_url}")
    print(f"- push target: {plan.push_url}")
    print("\nInitial commit metadata:")
    print(f"- message: {plan.commit.message}")
    print(f"- author and committer: {plan.commit.author_name} <{plan.commit.author_email}>")
    print(f"- timestamp: {timestamp}")
    print(f"- tree: {plan.commit.tree_oid}")
    print("\nInitial commit contents:")
    for item in plan.commit.files:
        print(f"- {item.mode} {item.object_id} {item.path}")
    print("\nComplete ordered transition:")
    for step in plan.steps:
        print(f"- {step}")
    print("\nLive desired-state findings:")
    for finding in plan.live_delta.findings:
        print(f"- {finding}")
    print("\nObserved GitHub state and permissions:")
    print(json.dumps(plan.observed_github_state, indent=2, sort_keys=True))
    print(f"\nPlan record: {path}")
    print("No target repository or GitHub repository mutation was performed.")
    print(f"Explicit confirmation required: {plan.confirmation}")


def _render_failure(report) -> None:
    print(f"error: {report.error}", file=sys.stderr)
    print("Completed work:", file=sys.stderr)
    if report.completed:
        for step in report.completed:
            print(f"- {step}", file=sys.stderr)
    else:
        print("- none", file=sys.stderr)
    if report.failed is not None:
        print("Failed work:", file=sys.stderr)
        print(f"- {report.failed}", file=sys.stderr)
    else:
        print("Completion unknown:", file=sys.stderr)
        print(f"- {report.uncertain}", file=sys.stderr)
    print("Remaining work:", file=sys.stderr)
    if report.remaining:
        for step in report.remaining:
            print(f"- {step}", file=sys.stderr)
    else:
        print("- none", file=sys.stderr)
    print("No destructive rollback was attempted.", file=sys.stderr)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Plan or perform first publication of a prepared repository"
    )
    subparsers = parser.add_subparsers(dest="operation", required=True)
    plan_parser = subparsers.add_parser(
        "plan", help="validate and preview without target mutation"
    )
    plan_parser.add_argument("repository")
    plan_parser.add_argument("--plan-file", required=True)
    publish_parser = subparsers.add_parser(
        "publish", help="revalidate and perform an explicitly confirmed Plan"
    )
    publish_parser.add_argument("--plan-file", required=True)
    publish_parser.add_argument(
        "--confirm",
        required=True,
        help="exact confirmation phrase printed by Plan",
    )
    args = parser.parse_args()

    adapter = GitHubCliAdapter()
    try:
        if args.operation == "plan":
            plan_path = Path(args.plan_file).expanduser().resolve()
            plan = plan_first_publication(
                Path(args.repository), adapter, standards_root=standards_root()
            )
            write_publication_plan(plan, plan_path)
            _render_plan(plan, plan_path)
            return 0
        plan = load_publication_plan(Path(args.plan_file))
        report = publish_first_publication(
            plan,
            adapter,
            standards_root=standards_root(),
            confirmation=args.confirm,
        )
    except PublicationError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 2

    if not report.complete:
        _render_failure(report)
        return 2
    print(f"Standards-complete repository: {plan.repository_name}")
    print(f"- initial commit: {report.commit_oid}")
    print("- main is published and established as the default branch")
    print("- committed content and re-observed GitHub state satisfy the selected release")
    print("- no pull request was created; later changes use ordinary implementation and GitHub delivery")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
