{
  "standards-version": 2,
  "standards-release": "1.1.0",
  "profiles": [
    "common",
    "documentation"
  ],
  "boundaries": [
    {
      "path": ".",
      "type": "repository",
      "title": "Repository Standards"
    }
  ],
  "variables": {},
  "local-fragments": {
    ".gitignore": [
      ".repository-standards/gitignore.local"
    ]
  },
  "repository-owned": [
    ".repository-standards.json",
    "README.md",
    "CHANGELOG.md",
    "VERSION",
    "docs/README.md",
    "standards/**",
    "profiles/**",
    "schema/**",
    "examples/**",
    "scripts/**",
    ".github/workflows/ci.yml"
  ]
}
