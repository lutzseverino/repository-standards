{
  "standards-version": 5,
  "standards-release": "5.0.0",
  "canonical-validation": {
    "executable": "scripts/validate",
    "arguments": [],
    "working-directory": "."
  },
  "profiles": [
    "common",
    "documentation"
  ],
  "boundaries": [
    {
      "path": ".",
      "type": "repository",
      "title": "Repository Standards"
    }
  ],
  "dependency-updates": [
    {
      "ecosystem": "github-actions",
      "directory": "/",
      "schedule": "weekly"
    }
  ],
  "github": {
    "repository": "lutzseverino/repository-standards",
    "default-branch": "main",
    "settings": {
      "delete-branch-on-merge": true,
      "allow-squash-merge": true,
      "allow-merge-commit": false,
      "allow-rebase-merge": false,
      "squash-merge-commit-title": "PR_TITLE",
      "squash-merge-commit-message": "PR_BODY"
    },
    "features": {
      "issues": true,
      "projects": false,
      "wiki": false
    },
    "ruleset": null
  },
  "variables": {},
  "local-fragments": {
    ".gitignore": [
      ".repository-standards/gitignore.local"
    ]
  },
  "repository-owned": [
    ".repository-standards.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "VERSION",
    "CONTEXT.md",
    "docs/README.md",
    "docs/consumer-acceptance.md",
    "docs/policy-resolver-model.md",
    "docs/agents/domain.md",
    "docs/adr/**",
    "standards/**",
    "bootstrap/**",
    "profiles/**",
    "schema/**",
    "examples/**",
    "scripts/**",
    ".github/workflows/ci.yml",
    ".github/workflows/release.yml",
    ".github/workflows/standards-check.yml"
  ]
}
