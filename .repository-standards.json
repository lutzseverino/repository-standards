{
  "standards-version": 3,
  "standards-release": "2.0.0",
  "profiles": [
    "common",
    "documentation"
  ],
  "boundaries": [
    {
      "path": ".",
      "type": "repository",
      "title": "Repository Standards"
    }
  ],
  "dependency-updates": [
    {
      "ecosystem": "github-actions",
      "directory": "/",
      "schedule": "weekly"
    }
  ],
  "github": {
    "repository": "lutzseverino/repository-standards",
    "default-branch": "main",
    "settings": {
      "delete-branch-on-merge": true,
      "allow-squash-merge": true,
      "allow-merge-commit": false,
      "allow-rebase-merge": false
    },
    "ruleset": null
  },
  "variables": {},
  "local-fragments": {
    ".gitignore": [
      ".repository-standards/gitignore.local"
    ]
  },
  "repository-owned": [
    ".repository-standards.json",
    "README.md",
    "CHANGELOG.md",
    "VERSION",
    "docs/README.md",
    "standards/**",
    "profiles/**",
    "schema/**",
    "examples/**",
    "scripts/**",
    ".github/workflows/ci.yml",
    ".github/workflows/standards-audit.yml"
  ]
}
