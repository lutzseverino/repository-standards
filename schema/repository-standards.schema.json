{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lutzseverino/repository-standards/main/schema/repository-standards.schema.json",
  "title": "Repository standards manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["standards-version", "standards-release", "profiles", "repository-owned"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "standards-version": {"const": 1},
    "standards-release": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "variables": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "local-fragments": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
      }
    },
    "repository-owned": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
    }
  }
}
