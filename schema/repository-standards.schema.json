{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lutzseverino/repository-standards/main/schema/repository-standards.schema.json",
  "title": "Repository standards manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["standards-version", "standards-release", "profiles", "boundaries", "dependency-updates", "github", "repository-owned"],
  "properties": {
    "$schema": {"type": "string", "format": "uri-reference"},
    "standards-version": {"const": 5},
    "standards-release": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
      "allOf": [
        {"contains": {"const": "common"}},
        {"contains": {"const": "documentation"}}
      ]
    },
    "boundaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "type", "title"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?:\\.|(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[*?\\[])[^/]+(?:/[^/]+)*)$"
          },
          "type": {"enum": ["repository", "collection", "project"]},
          "title": {"type": "string", "minLength": 1}
        }
      }
    },
    "dependency-updates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ecosystem", "directory", "schedule"],
        "properties": {
          "ecosystem": {"enum": ["github-actions", "maven", "npm"]},
          "directory": {"type": "string", "pattern": "^/(?!.*(?:^|/)\\.{1,2}(?:/|$))(?:[^/]+(?:/[^/]+)*)?$"},
          "schedule": {"enum": ["daily", "weekly", "monthly"]}
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "default-branch", "settings", "ruleset"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "default-branch": {"type": "string", "minLength": 1},
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["delete-branch-on-merge", "allow-squash-merge", "allow-merge-commit", "allow-rebase-merge"],
          "properties": {
            "delete-branch-on-merge": {"type": "boolean"},
            "allow-squash-merge": {"type": "boolean"},
            "allow-merge-commit": {"type": "boolean"},
            "allow-rebase-merge": {"type": "boolean"}
          }
        },
        "ruleset": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "required-status-checks", "require-current-branch", "required-approvals", "allowed-merge-methods", "prevent-deletion", "prevent-force-push", "allow-bypass-actors"],
              "properties": {
                "name": {"type": "string", "minLength": 1},
                "required-status-checks": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "require-current-branch": {"type": "boolean"},
                "required-approvals": {"type": "integer", "minimum": 0},
                "allowed-merge-methods": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"enum": ["merge", "rebase", "squash"]}
                },
                "prevent-deletion": {"type": "boolean"},
                "prevent-force-push": {"type": "boolean"},
                "allow-bypass-actors": {"const": false}
              }
            }
          ]
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]}
    },
    "local-fragments": {
      "type": "object",
      "propertyNames": {"pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
      }
    },
    "repository-owned": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
    }
  }
}
